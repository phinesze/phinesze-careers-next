{
  "$ref": "#/definitions/CareerHistory",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ProjectEnvironment": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": ["name"],
      "type": "object"
    },
    "ProjectEnvironmentList": {
      "additionalProperties": {
        "items": {
          "$ref": "#/definitions/ProjectEnvironment"
        },
        "type": "array"
      },
      "type": "object"
    },
    "CareerHistory": {
      "additionalProperties": false,
      "description": "経歴データのルート",
      "properties": {
        "sections": {
          "description": "セクションの種類は、ドキュメントセクションとプロジェクトグループセクションの2種類がある",
          "items": {
            "anyOf": [
              {
                "$ref": "#/definitions/DocumentSection"
              },
              {
                "$ref": "#/definitions/ProjectGroupSection"
              }
            ]
          },
          "title": "経歴データのセクションの配列",
          "type": "array"
        },
        "updatedAt": {
          "description": "経歴データの更新日を表す。YYYY-MM-DD形式で表す",
          "format": "date",
          "title": "更新日",
          "type": "string"
        }
      },
      "required": ["updatedAt", "sections"],
      "type": "object"
    },
    "ProjectTeamList": {
      "additionalProperties": {
        "items": {
          "type": "number"
        },
        "maxItems": 2,
        "minItems": 1,
        "type": "array"
      },
      "description": "経歴データにおける開発メンバーの数を表す { \"PM\": [参加人数], \"開発\": [最小人数, 最大人数] } のような形で表す",
      "type": "object"
    },
    "DocumentSection": {
      "additionalProperties": false,
      "description": "経歴データの中で、自己PRや全体の経歴を自由形式で記述するドキュメントのセクションを表す",
      "properties": {
        "label": {
          "description": "ドキュメントのラベルを自由形式で記述する。",
          "format": "text",
          "title": "ドキュメントのラベル",
          "type": "string"
        },
        "detail": {
          "description": "ドキュメントの本文を自由形式で記述する。HTML形式で記述することができる",
          "format": "text",
          "title": "ドキュメントの本文",
          "type": "string"
        },
        "type": {
          "const": "document",
          "type": "string"
        }
      },
      "required": ["label", "detail", "type"],
      "title": "ドキュメントセクション",
      "type": "object"
    },
    "Project": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "secretDetail": {
          "type": "string"
        },
        "environments": {
          "$ref": "#/definitions/ProjectEnvironmentList"
        },
        "teams": {
          "$ref": "#/definitions/ProjectTeamList"
        },
        "times": {
          "additionalProperties": false,
          "properties": {
            "start": {
              "type": "string"
            },
            "end": {
              "type": "string"
            }
          },
          "required": ["start"],
          "type": "object"
        }
      },
      "type": "object"
    },
    "ProjectGroup": {
      "additionalProperties": false,
      "properties": {
        "company": {
          "type": "string"
        },
        "companyAlias": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "projects": {
          "items": {
            "$ref": "#/definitions/Project"
          },
          "type": "array"
        }
      },
      "required": ["projects"],
      "type": "object"
    },
    "ProjectGroupSection": {
      "additionalProperties": false,
      "properties": {
        "groups": {
          "items": {
            "$ref": "#/definitions/ProjectGroup"
          },
          "type": "array"
        },
        "type": {
          "const": "project-groups",
          "type": "string"
        }
      },
      "required": ["groups", "type"],
      "type": "object"
    }
  }
}
